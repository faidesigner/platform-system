{
  "template": "multi-selector",
  "name": "MultiSelector",
  "description": "Multi-select checkbox dropdown. Generated on system/badge-component.",
  "trigger": {
    "radius": { "$pixelToken": "size.8" },
    "strokeWeight": 1,
    "stroke": { "$token": "semantic.light.border.secondary" },
    "layout": {
      "direction": "horizontal",
      "gap": { "$pixelToken": "size.8" },
      "padding": {
        "top": { "$pixelToken": "size.6" },
        "right": { "$pixelToken": "size.16" },
        "bottom": { "$pixelToken": "size.6" },
        "left": { "$pixelToken": "size.16" }
      }
    }
  },
  "list": {
    "radius": { "$pixelToken": "size.16" },
    "strokeWeight": 1,
    "fill": { "$token": "semantic.light.bg.100" },
    "stroke": { "$token": "semantic.light.border.tertiary" },
    "shadow": { "$token": "shadow.M" }
  },
  "option": {
    "checkbox": true,
    "label": {
      "fontSize": { "$pixelToken": "font.size.13" },
      "color": { "$token": "semantic.light.text.basic.primary" }
    }
  },
  "badge": {
    "radius": { "$pixelToken": "size.6" },
    "fill": { "$token": "semantic.light.filled.basic.secondary" }
  },
  "variants": [
    { "name": "display=count", "display": "count" },
    { "name": "display=badges", "display": "badges" },
    { "name": "searchable, select-all", "display": "count", "searchable": true, "selectAll": true },
    { "name": "sectioned", "display": "count", "sectioned": true }
  ]
}
