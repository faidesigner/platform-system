{
  "$schema": "https://design-tokens.org/schemas/draft-9",
  "$description": "FAI Design System — Semantic Color Tokens (Layer 2). 컴포넌트는 반드시 이 파일의 토큰만 참조할 것. 원시값은 color-global.json의 primitive 토큰을 alias로 참조.",
  "semantic": {
    "bg": {
      "$description": "배경(Background) 시맨틱 토큰",
      "surface":        { "light": "{color.white}",      "dark": "{color.gray.900}",  "$description": "페이지 기본 배경" },
      "surface-alt":    { "light": "{color.gray.30}",    "dark": "{color.gray.800}",  "$description": "카드·패널 보조 배경" },
      "surface-sunken": { "light": "{color.gray.50}",    "dark": "{color.gray.700}",  "$description": "인풋·비활성 영역 눌린 배경" },
      "surface-raised": { "light": "{color.white}",      "dark": "{color.gray.800}",  "$description": "모달·드롭다운 부상 배경" },
      "overlay":        { "light": "rgba(0,0,0,0.52)",   "dark": "rgba(0,0,0,0.35)",  "$description": "스크림 (딤드) 52% / 다크 35%" },
      "overlay-strong": { "light": "rgba(0,0,0,0.74)",   "dark": "rgba(0,0,0,0.74)",  "$description": "스크림 강조 74%" },
      "overlay-max":    { "light": "rgba(0,0,0,0.87)",   "dark": "rgba(0,0,0,0.87)",  "$description": "스크림 최대 87%" },
      "brand":          { "light": "{color.green.500}",  "dark": "{color.green.500}", "$description": "브랜드 기본 배경 (Green)" },
      "brand-subtle":   { "light": "{color.green.100}",  "dark": "{color.green.300}", "$description": "브랜드 연한 배경" },
      "fill-strong":    { "light": "{color.gray.800}",   "dark": "{color.gray.400}",  "$description": "강조 버튼·배지 배경" },
      "fill":           { "light": "{color.gray.500}",   "dark": "{color.gray.500}",  "$description": "보조 컴포넌트 배경" },
      "fill-soft":      { "light": "{color.gray.50}",    "dark": "{color.gray.700}",  "$description": "보조 버튼·태그 배경" },
      "fill-faint":     { "light": "{color.gray.30}",    "dark": "{color.gray.800}",  "$description": "호버·선택 영역 연한 배경" },
      "fill-inverse":   { "light": "{color.white}",      "dark": "{color.gray.900}",  "$description": "반전 배경 (어두운 영역 위 흰색)" },
      "fill-disabled":  { "light": "{color.gray.50}",    "dark": "{color.gray.700}",  "$description": "비활성 배경" },
      "success":        { "light": "{color.mint.50}",    "dark": "{color.mint.900}",  "$description": "성공 상태 배경" },
      "warning":        { "light": "{color.orange.50}",  "dark": "{color.orange.900}","$description": "경고 상태 배경" },
      "error":          { "light": "{color.red.50}",     "dark": "{color.red.900}",   "$description": "오류 상태 배경" },
      "info":           { "light": "{color.blue.50}",    "dark": "{color.blue.900}",  "$description": "정보 상태 배경" }
    },

    "color": {
      "$description": "텍스트 & 아이콘 시맨틱 토큰",
      "primary":        { "light": "{color.gray.900}",   "dark": "{color.white}",     "$description": "기본 본문 텍스트" },
      "secondary":      { "light": "{color.gray.700}",   "dark": "{color.gray.100}",  "$description": "보조 텍스트 (레이블·설명)" },
      "tertiary":       { "light": "{color.gray.500}",   "dark": "{color.gray.200}",  "$description": "힌트·플레이스홀더" },
      "quaternary":     { "light": "{color.gray.300}",   "dark": "{color.gray.400}",  "$description": "딤드·보조 캡션" },
      "inverse":        { "light": "{color.white}",      "dark": "{color.white}",     "$description": "반전 텍스트 (어두운 배경 위)" },
      "inverse-subtle": { "light": "{color.gray.100}",   "dark": "{color.gray.600}",  "$description": "반전 보조 텍스트" },
      "disabled":       { "light": "{color.gray.100}",   "dark": "{color.gray.600}",  "$description": "비활성 텍스트" },
      "brand":          { "light": "{color.green.600}",  "dark": "{color.green.500}", "$description": "브랜드 텍스트 (강조 Green)" },
      "on-brand":       { "light": "{color.white}",      "dark": "{color.gray.900}",  "$description": "브랜드 배경 위 텍스트" },
      "success":        { "light": "{color.mint.500}",   "dark": "{color.mint.400}",  "$description": "성공 상태 텍스트·아이콘" },
      "warning":        { "light": "{color.orange.500}", "dark": "{color.orange.400}","$description": "경고 상태 텍스트·아이콘" },
      "error":          { "light": "{color.red.500}",    "dark": "{color.red.400}",   "$description": "오류 상태 텍스트·아이콘" },
      "info":           { "light": "{color.blue.500}",   "dark": "{color.blue.400}",  "$description": "정보 상태 텍스트·아이콘" }
    },

    "border": {
      "$description": "테두리(Border) 시맨틱 토큰",
      "default":        { "light": "{color.gray.700}",   "dark": "{color.gray.200}",  "$description": "기본 테두리" },
      "subtle":         { "light": "{color.gray.100}",   "dark": "{color.gray.500}",  "$description": "보조 테두리" },
      "faint":          { "light": "{color.gray.50}",    "dark": "{color.gray.700}",  "$description": "연한 구분선" },
      "inverse":        { "light": "{color.white}",      "dark": "{color.white}",     "$description": "반전 테두리 (어두운 배경 위)" },
      "brand":          { "light": "{color.green.500}",  "dark": "{color.green.500}", "$description": "브랜드 테두리" },
      "brand-subtle":   { "light": "{color.green.300}",  "dark": "{color.green.700}", "$description": "브랜드 보조 테두리" },
      "disabled":       { "light": "{color.gray.30}",    "dark": "{color.gray.700}",  "$description": "비활성 테두리" },
      "success":        { "light": "{color.mint.500}",   "dark": "{color.mint.400}",  "$description": "성공 상태 테두리" },
      "warning":        { "light": "{color.orange.500}", "dark": "{color.orange.400}","$description": "경고 상태 테두리" },
      "error":          { "light": "{color.red.500}",    "dark": "{color.red.400}",   "$description": "오류 상태 테두리" },
      "info":           { "light": "{color.blue.500}",   "dark": "{color.blue.400}",  "$description": "정보 상태 테두리" }
    }
  }
}
