{
  "$schema": "https://design-tokens.org/schemas/draft-9",
  "$description": "FAI Design System — Spacing & Border Radius Tokens. CSS --fai-space-* 및 --fai-radius-* 변수 규격 정의.",

  "spacing": {
    "3xs": { "$value": "0.125rem", "$description": "2px  — --fai-space-3xs",  "$type": "dimension" },
    "2xs": { "$value": "0.25rem",  "$description": "4px  — --fai-space-2xs",  "$type": "dimension" },
    "xs":  { "$value": "0.375rem", "$description": "6px  — --fai-space-xs",   "$type": "dimension" },
    "s":   { "$value": "0.5rem",   "$description": "8px  — --fai-space-s",    "$type": "dimension" },
    "ms":  { "$value": "0.75rem",  "$description": "12px — --fai-space-ms",   "$type": "dimension" },
    "m":   { "$value": "1rem",     "$description": "16px — --fai-space-m",    "$type": "dimension" },
    "l":   { "$value": "1.25rem",  "$description": "20px — --fai-space-l",    "$type": "dimension" },
    "xl":  { "$value": "1.5rem",   "$description": "24px — --fai-space-xl",   "$type": "dimension" },
    "2xl": { "$value": "2rem",     "$description": "32px — --fai-space-2xl",  "$type": "dimension" },
    "3xl": { "$value": "2.5rem",   "$description": "40px — --fai-space-3xl",  "$type": "dimension" },
    "4xl": { "$value": "3.5rem",   "$description": "56px — --fai-space-4xl",  "$type": "dimension" }
  },

  "borderRadius": {
    "xs":     { "$value": "0.25rem",   "$description": "4px  — --fai-radius-xs",     "$type": "dimension" },
    "s":      { "$value": "0.5rem",    "$description": "8px  — --fai-radius-s",      "$type": "dimension" },
    "ms":     { "$value": "0.75rem",   "$description": "12px — --fai-radius-ms",     "$type": "dimension" },
    "m":      { "$value": "1rem",      "$description": "16px — --fai-radius-m",      "$type": "dimension" },
    "l":      { "$value": "1.25rem",   "$description": "20px — --fai-radius-l",      "$type": "dimension" },
    "xl":     { "$value": "1.5rem",    "$description": "24px — --fai-radius-xl",     "$type": "dimension" },
    "circle": { "$value": "62.438rem", "$description": "완전한 원 — --fai-radius-circle", "$type": "dimension" }
  },

  "tailwindMapping": {
    "$description": "Tailwind 클래스 접두어 참조 가이드",
    "spacing":      "p-fai-* / m-fai-* / gap-fai-* / w-fai-* / h-fai-*",
    "borderRadius": "rounded-fai-*"
  }
}
