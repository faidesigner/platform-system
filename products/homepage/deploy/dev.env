# DEV(프리뷰) 배포 설정 — 전용 CloudFront로 "루트 서빙"되는 미리보기
# 사용:  ./scripts/deploy.sh dev
#
# 프리뷰 전용 CloudFront(E1N1DKK4N6NNIM)는 origin-path=/homepage_v2 로
# S3 website 엔드포인트를 가리켜, 앱을 그 도메인의 루트에서 서빙한다(프로덕션과 동일 동작).

S3_DEST="s3://www.fainders.ai/homepage_v2"   # 라이브 루트와 분리된 prefix
CLOUDFRONT_ID="E1N1DKK4N6NNIM"               # 프리뷰 전용 배포
PREVIEW_URL="https://d6hs8futv6rcu.cloudfront.net"
AWS_REGION="ap-northeast-2"

NOINDEX="true"    # 프리뷰는 검색 색인 방지(전 페이지 noindex 주입)
FLAT_HTML="false" # 프리뷰 origin은 website 엔드포인트라 디렉토리 index.html 자동 → flat 불필요
DELETE="true"     # homepage_v2 prefix에 한정되므로 안전(라이브 루트 미접촉)
