# PRD(라이브) 배포 설정 — 실제 www.fainders.ai 루트
# 사용:  ./scripts/deploy.sh prd   (실행 시 확인 프롬프트 있음)
#
# ⚠️ 이것은 실서비스 루트 배포다. 구 사이트를 대체하는 컷오버이므로 신중히.

S3_DEST="s3://www.fainders.ai"               # 라이브 루트
CLOUDFRONT_ID="E3GUSL3ADNKGFD"               # 라이브 배포(www + apex)
PREVIEW_URL="https://www.fainders.ai"
AWS_REGION="ap-northeast-2"

NOINDEX="false"   # 라이브는 색인 허용(ko index / en·jp noindex 는 코드 메타로 제어)
FLAT_HTML="true"  # ⚠️ 라이브 CF 함수 rewriteForHomepageSSG 가 "/foo/ → /foo.html" 라
                  #    새 dir/index.html 구조와 안 맞음 → flat <dir>.html 생성으로 호환.
                  #    (장기적으론 CF 함수를 /foo/ → /foo/index.html 로 바꾸는 게 정석)
DELETE="false"    # ⚠️ 루트에서 --delete 는 구 사이트 파일(company.html, assets/, career/ 등)을
                  #    삭제한다. 완전 컷오버를 원할 때만 true 로. 기본은 안전하게 false.
